{
  "name": "prosekeep",
  "version": "0.3.0",
  "description": "Portable editorial standards and checks for AI-assisted writing: plain language, house style, source comparisons, Agent Skill, CLI and MCP.",
  "type": "module",
  "license": "CC0-1.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/quarterback/prosekeep.git"
  },
  "homepage": "https://github.com/quarterback/prosekeep#readme",
  "keywords": [
    "editorial",
    "plain-language",
    "content-standards",
    "house-style",
    "style-guide",
    "source-fidelity",
    "editorial-review",
    "ai-writing",
    "agent-skill",
    "mcp",
    "mcp-server",
    "cli",
    "writing",
    "lint"
  ],
  "bin": {
    "prosekeep": "bin/prosekeep.mjs",
    "prosekeep-mcp": "bin/prosekeep-mcp.mjs"
  },
  "exports": {
    ".": "./src/check.mjs"
  },
  "files": [
    "bin",
    "src",
    "skills",
    "profiles",
    "templates",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "examples",
    "docs"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "node --test",
    "check": "node bin/prosekeep.mjs check examples/clean.md",
    "prepublishOnly": "npm test && npm run check"
  },
  "publishConfig": {
    "access": "public"
  },
  "bugs": {
    "url": "https://github.com/quarterback/prosekeep/issues"
  }
}
